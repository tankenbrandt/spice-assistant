# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc

# Bundled ngspice binary distribution (49 MB; see README for setup)
tools/

# pytest
.pytest_cache/

# editable install metadata
*.egg-info/
build/
dist/

# Repeat benchmark runs: bulky per-attempt evidence kept for error bars.
# One buck-converter deck alone printed 18 MB of ngspice output. The summary
# that REPORT.md quotes is committed; the raw runs are not.
logs/repeats/*.json
!logs/repeats/summary.json

# spice-report output: generated per circuit, on demand.
runs/

# Resumes live here for convenience; they are not part of the project.
*.pdf
